# DevLens AI – environment configuration (optional)
# Export these in your shell, or copy this file to .env and start the
# backend with:  uvicorn main:app --env-file ../.env

# Base URL of the local Ollama server (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default model used when none is selected in the UI (default: mistral)
OLLAMA_MODEL=mistral